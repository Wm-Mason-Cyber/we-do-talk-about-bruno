[Unit]
Description=Class Roster API (Bruno lab) + live dashboard
After=network.target

[Service]
User=bruno-api
Group=bruno-api
WorkingDirectory=/opt/bruno-api/src
EnvironmentFile=/etc/bruno-api.env
ExecStart=/opt/bruno-api/venv/bin/uvicorn app:app \
    --host 127.0.0.1 --port 8000 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --timeout-graceful-shutdown 3 --no-access-log
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
